# PLACEHOLDERS ONLY. Production file lives at /etc/jhb/site.env, not in Git.
# Required during both build and runtime; use the existing external project.
SUPABASE_URL=https://your-existing-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Runtime only: required for private media, never expose with a VITE_ prefix.
SUPABASE_SERVICE_ROLE_KEY=your-external-private-key
# Runtime only: public HTTPS origin for relative article social-preview images.
SITE_ORIGIN=https://your-domain.example
# Scheduled refresh only; not needed to serve existing cached videos.
YOUTUBE_API_KEY=your-youtube-data-api-key
# Optional build-time overrides must match the server URL/public key above.
# VITE_SUPABASE_URL=https://your-existing-project.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key